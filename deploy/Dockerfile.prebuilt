# AegisNet appliance image from prebuilt binaries — built by the release
# workflow (.github/workflows/release.yml) for linux/amd64 and linux/arm64,
# or locally from `deploy/build-bundle.sh` output.
#
# Build context:
#   bin/<amd64|arm64>/aegisd  aegisctl  cloudflared  cloudflared.json
#                             (from deploy/cloudflared-latest.sh)
#   clients/                  (client app builds offered in the console)
#   install.sh                (the installer, stamped with this image's tag;
#                              servers fetch it from the image, see INSTALL.md)
#
# Runtime contract: unprivileged uid 10001, read-only root filesystem, no
# capabilities, one volume for all state. The console (8443) is HTTPS-only;
# devices connect to the edge (8444); 8080 answers ACME HTTP-01 challenges
# only while a certificate is being issued.
#
# Pin the base image to a reviewed digest before release use.
FROM debian:bookworm-slim
ARG TARGETARCH
RUN groupadd --system --gid 10001 aegisnet \
    && useradd --system --uid 10001 --gid 10001 --home-dir /var/lib/aegisnet --shell /usr/sbin/nologin aegisnet \
    && apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o 10001 -g 10001 -m 0700 /var/lib/aegisnet \
    && install -d -m 0755 /usr/share/aegisnet/clients
COPY bin/${TARGETARCH}/aegisd bin/${TARGETARCH}/aegisctl bin/${TARGETARCH}/cloudflared /usr/local/bin/
# The bundled connector's version and SHA-256; aegisd checks the binary
# against it before every start (and may run a newer verified download).
COPY bin/${TARGETARCH}/cloudflared.json /usr/share/aegisnet/cloudflared.json
RUN set -e; \
    sum=$(sed -n 's/.*"sha256":"\([0-9a-f]\{64\}\)".*/\1/p' /usr/share/aegisnet/cloudflared.json); \
    [ -n "$sum" ] || { echo "cloudflared.json has no sha256" >&2; exit 1; }; \
    echo "$sum  /usr/local/bin/cloudflared" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/aegisd /usr/local/bin/aegisctl /usr/local/bin/cloudflared; \
    chmod 0644 /usr/share/aegisnet/cloudflared.json
COPY clients/ /usr/share/aegisnet/clients/
COPY install.sh /usr/share/aegisnet/install.sh
ENV AEGIS_DATA_DIR=/var/lib/aegisnet
USER 10001:10001
VOLUME ["/var/lib/aegisnet"]
EXPOSE 8443 8444 8080
# Health uses the owner-only local IPC socket; there is deliberately no
# unauthenticated HTTP health endpoint.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["/usr/local/bin/aegisctl", "--socket", "/var/lib/aegisnet/aegisd.sock", "health"]
ENTRYPOINT ["/usr/local/bin/aegisd"]
LABEL org.opencontainers.image.title="AegisNet gateway" \
      org.opencontainers.image.source="https://github.com/OnTheThirdDay/aegis"
